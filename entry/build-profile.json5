{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "-DCMAKE_BUILD_TYPE=Release",
      "cppFlags": "",
      "abiFilters": [ "arm64-v8a" ]
    }
  },
  "buildOptionSet": [
    {
      "name": "debug",
      "arkOptions": {
        "types": []
      }
    },
    {
      "name": "release",
      "arkOptions": {
        "types": [],
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [ "./obfuscation-rules.txt" ]
          }
        }
      }
    }
  ],
  "targets": [ { "name": "default" } ]
}
