node_modules/
oh_modules/
build/
hvigor/output/
.hvigor/
**/.test/
oh-package-lock.json5
local.properties
.ohos/
# 本机签名配置（含签名材料路径与口令，属本机私有；模板见 build-profile.json5.template）
build-profile.json5
# 发布打包脚本（挂载上架签名档的私有发布流程，不入库；日常构建/装机见 deploy_ohos.sh）
scripts/onlyoffice/pack_release_app.sh
# third_party 由四个 submodule 管理（core/sdkjs/web-apps/build_tools，官方 release/v9.4.0）

# —— 生成产物（勿入库；可复现来源见 docs/ONLYOFFICE_OHOS_NEXT_STEPS.md §1）——
__pycache__/
*.pyc
# convertershell NAPI 模块产物（hvigor/build_convertershell.sh 生成，99MB+）
entry/src/main/cpp/types/libconvertershell/libs/
# rawfile 编辑器运行时资源：构建产物，python3 scripts/onlyoffice/build_editors_ohos.py 重生成
entry/src/main/resources/rawfile/onlyoffice/.hvigor/
entry/src/main/resources/rawfile/onlyoffice/fonts/
entry/src/main/resources/rawfile/onlyoffice/sdkjs/
entry/src/main/resources/rawfile/onlyoffice/webapps/
entry/src/main/resources/rawfile/onlyoffice/themes.json
# smoke 诊断脚本（源 scripts/onlyoffice/smoke/，构建脚本安装）
entry/src/main/resources/rawfile/onlyoffice/smoke/
# 空模板（make_empty_templates.py 由 templates_src/ 生成；构建期内容确定，勿跟踪——曾反复 dirty）
entry/src/main/resources/rawfile/onlyoffice/templates/
# 插件资产（AI 插件 + v1 框架；源 scripts/onlyoffice/plugins/ 入库，构建脚本解包安装）
entry/src/main/resources/rawfile/onlyoffice/plugins/
entry/src/main/resources/rawfile/onlyoffice/plugins.json
# 随包许可证文本（install_licenses 由仓库根 LICENSE/NOTICE 拷贝生成；About 面板许可行/NOTICE 行弹层引用）
entry/src/main/resources/rawfile/onlyoffice/licenses/
# 版本号（构建期内容哈希生成——阶段3，替代手改 VERSION_BUMP）
entry/src/main/resources/rawfile/onlyoffice/version.json
# 内置字体行名清单（build_editors_ohos.write_font_rows 由 FONT_INFOS 生成；userFonts.ets
# 读它做导入时的内置重名拦截——缺失=不拦，不阻断导入）
entry/src/main/resources/rawfile/onlyoffice/fontrows.json
# ascshim.js（make_ascshim.py 由 src/*.js 拼接生成）与 index.html（欢迎页，来自
# third_party/desktop-apps loginpage deploy）同为生成产物，与 webapps/fonts 等一并
# 不入库——fresh clone 编译 HAP 前本就必须先跑 grunt-build.sh（其余 rawfile 全在
# 库里缺失），"入库便于 clone 自足"的理由不成立；入库反而要求每次改 src 后手工
# 重新生成再提交（曾发生源码已改、产物忘记再生成的不一致）。
entry/src/main/resources/rawfile/onlyoffice/ascshim.js
entry/src/main/resources/rawfile/onlyoffice/index.html
# ohos 宿主装配域产物（源 scripts/onlyoffice/ohos/，其中 bridge.js 由装配链展开
# 模板生成——同上「源入库、产物勿跟踪」约定）
entry/src/main/resources/rawfile/onlyoffice/ohos/
# 样本（sample.*）是测试资产，保留跟踪；document.json/editor.html/document.docx 已退役删除
# 回归测试产物（tests/regression.sh 每次跑出来的日志/截图/汇总，按 runid 分目录——诊断用，勿跟踪；
# case 清单 cases.tsv 是源，保留跟踪）
scripts/onlyoffice/tests/out/
# native 构建产物/工具链拷贝
entry/libs/
entry/.cxx/
# 构建与临时产物
.temp/
# CJK 全量源（不入库，宋体 31.5MB / 黑体 19.9MB；由 make_cjk_font_src.sh 从 SDK
# previewer 幂等重建——子集化产物才入库，见 build_editors_ohos.py FONT_SUBSETS）
scripts/onlyoffice/templates_src/fonts/NotoSansCJK-SC.ttf
# Fandol 仿宋/楷体全量（7.6/8.8MB，otf2ttf CFF→glyf 产物；CTAN fandol.zip 复现
# 命令见 make_cjk_font_src.sh 注释；subset 版本入库——全新克隆由
# make_cjk_subset 幂等复用，同 NotoSerifCJK 策略）
scripts/onlyoffice/templates_src/fonts/FandolFang.ttf
scripts/onlyoffice/templates_src/fonts/FandolKai.ttf
# —— 例外：*.subset.ttf 刻意入库（NotoSerifCJK-SC 2026-09-05 宋体修复；
#   NotoSansCJK-SC 2026-09-24 换黑体）——
#   全量源 31.5/19.9MB 不入库；subset 是全新克隆重建字体的唯一字体资产
#   （make_cjk_subset 幂等分支「src 缺失 → 复用产物」依赖它），git clone 后无需
#   otf2ttf/SDK TTC 即可构建。勿按"中间产物"套用上一条规则。

# Windows/WSL 下载来源标记（NTFS 备用数据流，随文件从浏览器/资源管理器拷入而产生，
# 名字形如 "<原名>:Zone.Identifier"，内容是来源 URL；无任何入库价值）
*:Zone.Identifier

